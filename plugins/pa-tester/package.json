{
  "name": "tessera-plugin-pa-tester",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Klipper pa_tester for Tessera: a Pressure Advance tab in Calibrations with a live load cell graph",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
