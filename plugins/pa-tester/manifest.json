{
  "id": "tessera/pa-tester",
  "name": "Pressure Advance tester",
  "version": "0.2.0",
  "description": "Klipper pa_tester in a Pressure Advance tab of Calibrations: run the measurement, read the result, watch the load cell live",
  "author": "Tessera",
  "entry": "index.js",
  "pluginApi": "0.9",
  "dependencies": { "@core/calibrations": "3.0.0" },
  "locales": ["en", "ru"],

  "extensions": [
    {
      "point": "@core/calibrations#tabs",
      "kind": "tab",
      "version": 1,
      "id": "pa-tester",
      "titleKey": "patester.tabTitle",
      "element": "tessera-pa-tester-tab"
    }
  ],

  "overlays": [
    { "id": "pa-tester-bridge", "element": "tessera-pa-tester-bridge" }
  ],

  "guards": [
    {
      "id": "pa-tester-safety",
      "match": ["printer.gcode.script"],
      "handler": "guardPaTester"
    }
  ]
}
