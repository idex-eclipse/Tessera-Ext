{
  "name": "tessera-plugin-spoolman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spoolman integration for Tessera: spools per tool, pre-print filament check",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
