{
  "name": "tessera-plugin-motion-diag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motion diagnostics for Tessera: a browser port of Klipper's motan (capture, decode, analyze, graph, save)",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch --mode dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "happy-dom": "^20.14.6",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "uplot": "^1.6.32"
  }
}
